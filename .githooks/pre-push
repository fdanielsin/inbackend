#!/bin/bash
# Pre-push hook for Go backend
# Runs unit tests before pushing (skip integration tests that need Docker)

set -e

echo "🧪 Running pre-push tests..."

# Run unit tests only (skip integration tests with -short flag)
echo "  • Running unit tests (skipping Docker-dependent tests)..."
if ! go test -short -run "^(Test[^D]|TestD[^a])" ./...; then
  # If short tests fail, still allow push but warn
  echo "⚠️  Some tests failed, but allowing push (GitHub Actions will validate)"
fi

echo "✅ Ready to push"
exit 0
