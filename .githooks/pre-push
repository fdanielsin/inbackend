#!/usr/bin/env bash
# Pre-push : refus d'un push vers main (sauf release), puis lint, build et tests
# unitaires. Rapide (aucun Docker) et bloquant : l'intégration, l'e2e et la
# couverture tournent en CI (`make cover` en local).
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# D'abord la garde de main : elle lit les refs poussées sur l'entrée standard.
scripts/check-push-main.sh

echo "pre-push: lint"
make lint
echo "pre-push: build"
go build ./...
echo "pre-push: unit tests"
go test -race -shuffle=on ./tests/units/... ./internal/...

echo "pre-push: OK"
