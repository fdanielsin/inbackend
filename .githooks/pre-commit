#!/bin/bash
# Pre-commit hook for Go backend
# Validates: format, vet, tests before allowing commit

set -e

echo "🔍 Running pre-commit checks..."

# Check if we're in git
if ! git rev-parse --git-dir > /dev/null 2>&1; then
  exit 0
fi

# Get changed Go files
CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' | grep -v _test.go || true)

if [ -z "$CHANGED_FILES" ]; then
  exit 0
fi

echo "📝 Checking Go files..."

# Format check
echo "  ✓ Format check (gofmt)..."
if ! gofmt -l $CHANGED_FILES | grep -q .; then
  gofmt -l $CHANGED_FILES | while read file; do
    echo "    ❌ $file needs formatting"
    gofmt -w "$file"
    git add "$file"
  done
fi

# Vet check
echo "  ✓ Static analysis (go vet)..."
if ! go vet ./...; then
  echo "❌ go vet failed"
  exit 1
fi

# Basic compile check
echo "  ✓ Compile check..."
if ! go build -o /tmp/app .; then
  echo "❌ Build failed"
  exit 1
fi

echo "✅ Pre-commit checks passed"
exit 0
