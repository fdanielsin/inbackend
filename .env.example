# Backend Configuration
#
# Variables réellement lues par le code (main.go, internal/infrastructure/logger).

# Requis : URL de connexion PostgreSQL (le serveur refuse de démarrer sans elle
# ou si ce n'est pas une URL).
# Format URL obligatoire (postgres:// ou postgresql://), aussi pour `make migrate-*`.
DATABASE_URL=postgres://postgres:password@localhost:5432/inbackend?sslmode=disable

# Optionnel : "production" active le format de log zap de production ; toute
# autre valeur (ou absence) utilise le format développement.
ENV=development

# Optionnel : origines CORS autorisées, séparées par des virgules ("*" par défaut,
# à restreindre en production, ex. https://app.example.com,https://admin.example.com).
CORS_ALLOWED_ORIGINS=*

# Optionnel : port d'écoute HTTP, 8080 par défaut si absent.
PORT=8080
