# Backend Configuration
#
# Variables réellement lues par le code (main.go, internal/infrastructure/applog).

# Requis : URL de connexion PostgreSQL (le serveur refuse de démarrer sans elle
# ou si ce n'est pas une URL).
# Format URL obligatoire (postgres:// ou postgresql://), aussi pour `make migrate-*`.
DATABASE_URL=postgres://postgres:password@localhost:5432/inbackend?sslmode=disable

# Optionnel : "production" journalise en JSON au niveau Info ; toute autre valeur
# (ou absence) journalise en texte au niveau Debug.
ENV=development

# Origines CORS autorisées, séparées par des virgules ("*" par défaut). Obligatoire
# quand ENV vaut exactement "production" : absente, vide ou contenant "*", le serveur
# ne démarre pas (ex. https://app.example.com,https://admin.example.com).
CORS_ALLOWED_ORIGINS=*

# Optionnel : sert le contrat sur /openapi.yaml et Swagger UI sur /docs (chargé depuis
# un CDN). Actif par défaut, inactif si ENV=production ; true ou false pour forcer.
API_DOCS_ENABLED=true

# Optionnel : port d'écoute HTTP, 8080 par défaut si absent.
PORT=8080
